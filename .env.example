# ============================================================
# ShopPilot AI - Zero-Budget / Local-First Environment Config
# ============================================================

# Application Server
PORT=3000
NODE_ENV=development
APP_URL="http://localhost:3000"

# Local PostgreSQL Database (Docker Compose)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shoppilot_db"

# Authentication & Session Security (Local secret)
SESSION_SECRET="shoppilot_local_development_secret_key_change_in_production"

# Local AI Engine (Ollama Default)
AI_PROVIDER="local"
AI_BASE_URL="http://localhost:11434"
AI_MODEL="qwen2.5:3b"

# Local RAG & Embedding Model (Free/Local)
EMBEDDING_PROVIDER="local"
EMBEDDING_MODEL="all-minilm-l6-v2"

